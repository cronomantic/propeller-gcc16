# The rest of the toolchain, pinned to the commits propgcc-16 was built
# and tested with.  The URLs are relative to this repository's, so they
# point to forks of the same names next to it on GitHub:
#   binutils-propeller  <- totalspectrum/binutils-propeller
#   proplib             <- totalspectrum/proplib (branch propgcc16: a printf
#                          fix, "%.0f")
#   propeller-load      <- dbetz/propeller-load
#   OpenSpin            <- parallaxinc/OpenSpin (branch propgcc16: a fix for
#                          the include path on Windows)
[submodule "deps/binutils-propeller"]
	path = deps/binutils-propeller
	url = ../binutils-propeller.git
	shallow = true
[submodule "deps/proplib"]
	path = deps/proplib
	url = ../proplib.git
	shallow = true
	branch = propgcc16
[submodule "deps/propeller-load"]
	path = deps/propeller-load
	url = ../propeller-load.git
	shallow = true
[submodule "deps/OpenSpin"]
	path = deps/OpenSpin
	url = ../OpenSpin.git
	shallow = true
	branch = propgcc16
